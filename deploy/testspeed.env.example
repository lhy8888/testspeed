# Loaded by systemd from /etc/testspeed/testspeed.env.
# Restart testspeed.service after changing this file.
ADDR=:8080
NODE_ID=node-1
NODE_NAME=默认测速节点
# Optional display label; set this for the server's actual deployment location.
SERVER_LOCATION=
# FreeIPAPI receives public client IPs for approximate IP-based location.
# Private addresses are never queried. Lookup failure does not block speed tests.
GEOIP_ENABLED=true
# auto: online first, then optional local MMDB fills missing fields or failures.
# online: online lookup only. offline: local lookup only, no third-party calls.
GEOIP_PROVIDER=auto
# Optional licensed database; not downloaded or bundled automatically.
# The service must be able to read it. Restart after replacing the database.
# GEOIP_DB_PATH=/etc/testspeed/geoip.mmdb
# Optional label for non-public client addresses; never used for public IPs.
# CLIENT_NETWORK_LABEL=企业内网
# Only trust the addresses/CIDRs of proxies you control; empty ignores forwarding headers.
# TRUSTED_PROXIES=127.0.0.1/32,::1/128
# Default: one public port, fixed 8 streams, adjustable up to 30.
TEST_TRANSPORT=websocket
MEASUREMENT_PORTS=
MAX_TEST_STREAMS=30
MAX_CONCURRENT_TEST_REQUESTS=128
UPLOAD_SESSION_LIMIT=256
TEST_DOWNLOAD_DURATION_MS=10000
TEST_UPLOAD_DURATION_MS=10000
TEST_WARMUP_MS=1500

# Optional result sharing. Empty path keeps SQLite persistence disabled.
# Enable via /opt/testspeed/manage.sh share on for systemd-managed installs.
# Shares are client-submitted reports, not server-certified measurements.
SHARE_DB_PATH=
# Optional write token; set only in private configuration, never in a public URL.
# SHARE_WRITE_TOKEN=replace-with-a-private-token
SHARE_RETENTION_HOURS=168
SHARE_MAX_RESULTS=10000

# Set this if the public website origin differs from the listener.
# PUBLIC_ORIGIN=https://speed.example.com
# Optional HTTP transport uses four additional measurement ports:
# TEST_TRANSPORT=http
# MEASUREMENT_PORTS=8081,8082,8083,8084
# MAX_TEST_STREAMS=24
# MEASUREMENT_ORIGINS=https://speed.example.com:8081,https://speed.example.com:8082,https://speed.example.com:8083,https://speed.example.com:8084
